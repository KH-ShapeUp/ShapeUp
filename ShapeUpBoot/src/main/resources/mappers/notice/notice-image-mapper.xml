<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ShapeUp.boot.domain.notice.model.mapper.NoticeImageMapper">

	<insert id="insertNoticeImage" parameterType="com.ShapeUp.boot.app.notice.dto.NoticeInsertImageDto">
        
        <selectKey keyProperty="imgNo" resultType="_int" order="BEFORE">
            SELECT SEQ_NOTICE_IMG_NO.NEXTVAL FROM DUAL
        </selectKey>
        
        INSERT INTO NOTICE_IMG_TBL (
            IMG_NO, NOTICE_NO, IMG_PATH, IMG_RENAME, IMG_ORIGINAL_NAME) 
            VALUES (
            #{imgNo},
            #{noticeNo},
            #{imgPath},
            #{imgRename},
            #{imgOriginalName}
        )
    </insert>
    
</mapper>