<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ShapeUp.boot.domain.user.model.mapper.UserMapper">

    <!-- ResultMap (첫 번째 XML에서 가져온 정식 매핑 버전) -->
    <resultMap id="userResultMap" type="com.ShapeUp.boot.domain.user.model.vo.UserVO">
        <id property="userNo" column="USER_NO"/>
        <result property="userId" column="USER_ID"/>
        <result property="userPw" column="USER_PW"/>
        <result property="userName" column="USER_NAME"/>
        <result property="userAge" column="USER_AGE"/>
        <result property="userEmail" column="USER_EMAIL"/>
        <result property="userPhone" column="USER_PHONE"/>
        <result property="userSerialNo" column="USER_SERIAL_NO"/>
        <result property="userType" column="USER_TYPE"/>
        <result property="createdAt" column="CREATED_AT"/>
        <result property="updatedAt" column="UPDATED_AT"/>
        <result property="userNickname" column="USER_NICKNAME"/>
        <result property="status" column="STATUS"/>
    </resultMap>


    <!-- 회원가입 (두 번째 XML 버전 사용) -->
    <insert id="insertUser" parameterType="UserVO">
        INSERT INTO USER_TBL
        (
            USER_NO, 
            USER_ID, 
            USER_PW, 
            USER_NAME, 
            USER_AGE,
            USER_EMAIL, 
            USER_PHONE,
            USER_SERIAL_NO,
            USER_NICKNAME,
            USER_TYPE,
            STATUS,
            CREATED_AT,
            UPDATED_AT
        )
        VALUES
        (
            SEQ_USER_NO.NEXTVAL,
            #{userId},
            #{userPw},
            #{userName},
            #{userAge},
            #{userEmail},
            #{userPhone},
            #{userSerialNo},
            #{userNickname},
            #{userType},
            #{status},
            SYSTIMESTAMP,
            SYSTIMESTAMP
        )
    </insert>


    <!-- 아이디 중복 체크 (두 번째 버전) -->
    <select id="checkUserIdDuplicate" resultType="int">
        SELECT COUNT(*) FROM USER_TBL WHERE USER_ID = #{userId}
    </select>

    <!-- 닉네임 중복 체크 (두 번째 버전) -->
    <select id="checkNicknameDuplicate" resultType="int">
        SELECT COUNT(*) FROM USER_TBL WHERE USER_NICKNAME = #{nickname}
    </select>


    <!-- 아이디로 회원 조회 → resultMap 반영 -->
    <select id="selectUserById" resultMap="userResultMap">
        SELECT *
        FROM USER_TBL
        WHERE USER_ID = #{userId}
    </select>

    <!-- 이메일로 회원 조회 → resultMap 반영 -->
    <select id="selectUserByEmail" resultMap="userResultMap">
        SELECT *
        FROM USER_TBL
        WHERE USER_EMAIL = #{email}
    </select>


    <!-- 이름 + 이메일로 회원 찾기 (두 번째 XML) -->
    <select id="findUserByNameAndEmail" resultMap="userResultMap">
        SELECT *
        FROM USER_TBL
        WHERE USER_NAME = #{name}
        AND USER_EMAIL = #{email}
    </select>


    <!-- 비밀번호 찾기 - 아이디 + 이름 + 이메일 -->
    <select id="selectUserByIdAndNameAndEmail" resultMap="userResultMap">
        SELECT *
        FROM USER_TBL
        WHERE USER_ID = #{userId}
        AND USER_NAME = #{name}
        AND USER_EMAIL = #{email}
    </select>


    <!-- 비밀번호 변경 (두 번째 XML 버전) -->
    <update id="updatePassword">
        UPDATE USER_TBL
        SET USER_PW = #{encodedPassword},
            UPDATED_AT = SYSTIMESTAMP
        WHERE USER_ID = #{userId}
    </update>


    <!-- USER_ID로 USER_NO 조회 -->
    <select id="selectUserNoByUserId" resultType="int">
        SELECT USER_NO FROM USER_TBL WHERE USER_ID = #{userId}
    </select>


    <!-- 사용자 관심사 추가 (두 번째 XML 버전) -->
    <insert id="insertUserInterest">
        INSERT INTO USER_INTEREST
        (
            USER_INTEREST_NO,
            USER_NO,
            INTEREST_ACTIVITY,
            ACTIVE_TIME,
            ACTIVE_LOCATION
        )
        VALUES
        (
            SEQ_USER_INTEREST.NEXTVAL,
            #{userNo},
            #{interests},
            #{times},
            #{addresses}
        )
    </insert>

</mapper>
