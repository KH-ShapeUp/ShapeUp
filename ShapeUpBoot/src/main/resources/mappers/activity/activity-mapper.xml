<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
 PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
 <mapper namespace="com.ShapeUp.boot.domain.activity.model.mapper.ActivityMapper">
 	<select id="getActivityListByKeyword" resultType="ActivityVo">
 		SELECT * 
 		FROM ACTIVITY_TBL
 		WHERE LIKE ACTIVITY_NAME '%'||#{keyword}||'%' 
 		ORDER BY ACTIVITY_NAME ASC
 	</select>
 </mapper>