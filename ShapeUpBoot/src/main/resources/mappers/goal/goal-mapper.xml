<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ShapeUp.boot.domain.goal.model.mapper.GoalMapper">

    <!-- ResultMap 정의 -->
    <resultMap id="goalResultMap" type="com.ShapeUp.boot.domain.goal.model.vo.GoalVO">
        <id property="userNo" column="USER_NO"/>
        <result property="goalWeight" column="GOAL_WEIGHT"/>
        <result property="goalFat" column="GOAL_FAT"/>
        <result property="goalSmm" column="GOAL_SMM"/>
        <result property="goalCalorie" column="GOAL_CALORIE"/>
        <result property="createdAt" column="CREATED_AT"/>
        <result property="updatedAt" column="UPDATED_AT"/>
    </resultMap>

    <!-- 사용자 번호로 목표 조회 -->
    <select id="selectGoalByUserNo" parameterType="int" resultMap="goalResultMap">
        SELECT 
            USER_NO,
            GOAL_WEIGHT,
            GOAL_FAT,
            GOAL_SMM,
            GOAL_CALORIE,
            CREATED_AT,
            UPDATED_AT
        FROM 
            GOAL_TBL
        WHERE 
            USER_NO = #{userNo}
    </select>

    <!-- 목표 등록 -->
    <insert id="insertGoal" parameterType="com.ShapeUp.boot.domain.goal.model.vo.GoalVO">
        INSERT INTO GOAL_TBL (
            USER_NO,
            GOAL_WEIGHT,
            GOAL_FAT,
            GOAL_SMM,
            GOAL_CALORIE,
            CREATED_AT,
            UPDATED_AT
        ) VALUES (
            #{userNo},
            #{goalWeight},
            #{goalFat},
            #{goalSmm},
            #{goalCalorie, jdbcType=NUMERIC},
            SYSTIMESTAMP,
            SYSTIMESTAMP
        )
    </insert>

    <!-- 목표 수정 -->
    <update id="updateGoal" parameterType="com.ShapeUp.boot.domain.goal.model.vo.GoalVO">
        UPDATE GOAL_TBL
        SET 
            GOAL_WEIGHT = #{goalWeight},
            GOAL_FAT = #{goalFat},
            GOAL_SMM = #{goalSmm},
            GOAL_CALORIE = #{goalCalorie, jdbcType=NUMERIC},
            UPDATED_AT = SYSTIMESTAMP
        WHERE 
            USER_NO = #{userNo}
    </update>

    <!-- 목표 삭제 -->
    <delete id="deleteGoal" parameterType="int">
        DELETE FROM GOAL_TBL
        WHERE USER_NO = #{userNo}
    </delete>

</mapper>